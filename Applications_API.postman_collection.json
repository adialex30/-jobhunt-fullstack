{
	"info": {
		"_postman_id": "8a32bb58-e3cf-48ad-8d39-e58f297924c1",
		"name": "JobHunt - Feature Application Tracking & Jobs API",
		"description": "Collection Postman lengkap untuk branch feature/application-tracking pada aplikasi JobHunt Fullstack.\nMencakup seluruh endpoint Auth, Jobs, dan Application Tracking antara Job Seeker dan Recruiter.\n\nFitur:\n- Auto-save JWT token ke collection variable saat login\n- Dilengkapi pre-configured token siap pakai (aktif 30 hari)\n- Contoh request & response lengkap",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User (POST /api/auth/register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kandidat Baru\",\n  \"email\": \"kandidat.baru@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"job_seeker\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Mendaftarkan pengguna baru dengan pilihan role: 'job_seeker' atau 'recruiter'."
					},
					"response": []
				},
				{
					"name": "Login Job Seeker (POST /api/auth/login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const res = pm.response.json();",
									"    if (res.data && res.data.token) {",
									"        pm.collectionVariables.set('seeker_token', res.data.token);",
									"        console.log('✓ seeker_token berhasil disimpan ke Collection Variables!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login sebagai Job Seeker. Token otomatis disimpan ke variabel 'seeker_token'."
					},
					"response": []
				},
				{
					"name": "Login Recruiter (POST /api/auth/login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const res = pm.response.json();",
									"    if (res.data && res.data.token) {",
									"        pm.collectionVariables.set('recruiter_token', res.data.token);",
									"        console.log('✓ recruiter_token berhasil disimpan ke Collection Variables!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"recruiters@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login sebagai Recruiter. Token otomatis disimpan ke variabel 'recruiter_token'."
					},
					"response": []
				},
				{
					"name": "Get Profile Me (GET /api/auth/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{seeker_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Mengambil data profil pengguna yang sedang login berdasarkan JWT token."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Jobs",
			"item": [
				{
					"name": "Semua Job Aktif (GET /api/jobs)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs?page=1&limit=10&keyword=&type=&location=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "keyword",
									"value": "",
									"description": "Pencarian judul atau perusahaan (bisa debounced)"
								},
								{
									"key": "type",
									"value": "",
									"description": "Filter tipe: full-time, part-time, contract, internship"
								},
								{
									"key": "location",
									"value": "",
									"description": "Filter kota atau 'Remote'"
								},
								{
									"key": "sort",
									"value": "newest",
									"description": "Urutkan: newest | applicants"
								}
							]
						},
						"description": "Mendapatkan katalog lowongan pekerjaan yang sedang aktif (Public)."
					},
					"response": []
				},
				{
					"name": "Detail Satu Job (GET /api/jobs/:id)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}"
							]
						},
						"description": "Mendapatkan detail satu lowongan pekerjaan berdasarkan ID (Public)."
					},
					"response": []
				},
				{
					"name": "Daftar Job Milik Recruiter (GET /api/jobs/mine)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/mine?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"mine"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Daftar seluruh lowongan pekerjaan yang dipublikasikan oleh recruiter yang sedang login (Role: Recruiter)."
					},
					"response": []
				},
				{
					"name": "Posting Job Baru (POST /api/jobs)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Principal Spatial Systems Engineer\",\n  \"company\": \"Aura Studios\",\n  \"location\": \"Remote\",\n  \"type\": \"full-time\",\n  \"description\": \"Memimpin arsitektur sistem grafika 3D dan spatial rendering untuk platform generasi berikutnya.\",\n  \"requirements\": \"- 5+ tahun pengalaman C++ / Rust\\n- Pemahaman mendalam Metal / Vulkan\\n- Portofolio spatial computing\",\n  \"salary_min\": 28000000,\n  \"salary_max\": 45000000\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/jobs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs"
							]
						},
						"description": "Recruiter membuat lowongan pekerjaan baru (Role: Recruiter)."
					},
					"response": []
				},
				{
					"name": "Update Job (PUT /api/jobs/:id)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Senior Spatial Systems Engineer (Updated)\",\n  \"salary_min\": 30000000,\n  \"salary_max\": 50000000,\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}"
							]
						},
						"description": "Mengubah lowongan pekerjaan. Dilindungi kepemilikan (hanya milik recruiter yang bersangkutan)."
					},
					"response": []
				},
				{
					"name": "Hapus Job (DELETE /api/jobs/:id)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}"
							]
						},
						"description": "Menghapus lowongan pekerjaan secara permanen (hanya milik recruiter yang bersangkutan)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Applications - Job Seeker",
			"item": [
				{
					"name": "Lamar Pekerjaan (POST /api/jobs/:id/apply)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{seeker_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
