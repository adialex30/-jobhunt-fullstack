							"raw": "{{base_url}}/api/applications/mine",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"applications",
								"mine"
							]
						},
						"description": "Melihat riwayat lamaran yang telah diajukan beserta status terkininya (pending / reviewed / rejected)."
					},
					"response": []
				}
			]
		},
