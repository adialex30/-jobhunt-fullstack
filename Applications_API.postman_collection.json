						"body": {
							"mode": "raw",
							"raw": "{\n  \"cover_letter\": \"Saya sangat tertarik untuk melamar posisi ini karena memiliki pengalaman relevan dalam pengembangan sistem spatial computing dan microservices.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}/apply",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}",
								"apply"
							]
						},
						"description": "Mengajukan lamaran pada lowongan pekerjaan tertentu.\n- Auth: Job Seeker\n- Body: cover_letter (opsional)"
					},
					"response": []
				},
				{
					"name": "Riwayat Lamaran Saya (GET /api/applications/mine)",
