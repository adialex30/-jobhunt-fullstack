{
	"info": {
		"_postman_id": "8a32bb58-e3cf-48ad-8d39-e58f297924c1",
		"name": "JobHunt - Applications & Tracking API",
		"description": "Collection Postman untuk fitur Riwayat Lamaran (Applications) antara Job Seeker dan Recruiter sesuai spesifikasi:\n1. POST /api/jobs/:id/apply - Lamar pekerjaan (Job Seeker)\n2. GET /api/applications/mine - Riwayat lamaran user login (Job Seeker)\n3. GET /api/jobs/:id/applicants - Daftar pelamar untuk job tertentu (Recruiter)\n4. PUT /api/applications/:id - Update status lamaran (Recruiter)\n\nSudah dilengkapi dengan variabel token siap pakai (active 30 hari).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Opsional / Helper)",
			"item": [
				{
					"name": "Login Job Seeker",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('seeker_token', jsonData.data.token);",
									"        console.log('Seeker token otomatis disimpan ke collection variable!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"budi@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login sebagai Job Seeker untuk mendapatkan token JWT baru."
					},
					"response": []
				},
				{
					"name": "Login Recruiter",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('recruiter_token', jsonData.data.token);",
									"        console.log('Recruiter token otomatis disimpan ke collection variable!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"recruiters@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login sebagai Recruiter untuk mendapatkan token JWT baru."
					},
					"response": []
				},
				{
					"name": "Get Profile Me",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{seeker_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Cek data profil pengguna yang sedang login."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Applications - Job Seeker",
			"item": [
				{
					"name": "Lamar Pekerjaan (POST /api/jobs/:id/apply)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{seeker_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cover_letter\": \"Saya sangat tertarik untuk melamar posisi ini karena memiliki keahlian dan portofolio yang relevan dengan kebutuhan tim.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}/apply",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}",
								"apply"
							]
						},
						"description": "Endpoint bagi Job Seeker untuk melamar lowongan pekerjaan tertentu.\n- Auth: Job Seeker (Bearer Token)\n- Body: cover_letter (opsional)"
					},
					"response": []
				},
				{
					"name": "Riwayat Lamaran Saya (GET /api/applications/mine)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{seeker_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/applications/mine",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"applications",
								"mine"
							]
						},
						"description": "Melihat seluruh riwayat lamaran yang diajukan oleh Job Seeker yang sedang login, lengkap dengan judul posisi, perusahaan, tanggal melamar, dan statusnya (pending / reviewed / rejected)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Applications - Recruiter",
			"item": [
				{
					"name": "Daftar Pelamar Suatu Job (GET /api/jobs/:id/applicants)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/{{job_id}}/applicants",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"{{job_id}}",
								"applicants"
							]
						},
						"description": "Melihat daftar pelamar untuk job tertentu milik Recruiter yang sedang login.\n- Auth: Recruiter\n- Status: 200 OK dengan list pelamar (nama, email, cover letter, status, waktu lamaran)."
					},
					"response": []
				},
				{
					"name": "Update Status Lamaran (PUT /api/applications/:id)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"reviewed\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/applications/{{application_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"applications",
								"{{application_id}}"
							]
						},
						"description": "Memperbarui status lamaran pelamar.\n- Auth: Recruiter (pemilik lowongan)\n- Body: status ('pending' | 'reviewed' | 'rejected')"
					},
					"response": []
				},
				{
					"name": "Update Status Lamaran -> Rejected (PUT /api/applications/:id)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"rejected\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/applications/{{application_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"applications",
								"{{application_id}}"
							]
						},
						"description": "Contoh mengubah status pelamar menjadi 'rejected'."
					},
					"response": []
				},
				{
					"name": "Dashboard Recruiter Summary (GET /api/applications/dashboard)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{recruiter_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/applications/dashboard",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"applications",
								"dashboard"
							]
						},
						"description": "Mendapatkan ringkasan dashboard recruiter: total lowongan yang diposting, total pelamar, serta breakdown status (pending, reviewed, rejected)."
					},
					"response": []
				}
			]
		}
	],
